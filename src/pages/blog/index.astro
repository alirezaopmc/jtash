---
import Base from '../../layouts/BlogBase.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const description = 'Writing on software, products, and keeping a body that sits at a desk working.';
---

<Base title="Notes · jtash" description={description}>
  <main class="wrap">
    <h1 class="page-title">Notes</h1>
    <p class="intro">{description}</p>
    {
      posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="index">
          {posts.map((post) => (
            <li class="index-item">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <a class="index-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
              <p class="index-desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
