---
import Base from './BlogBase.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  minutes: number;
  tags: string[];
}

const { title, description, date, updated, minutes, tags } = Astro.props;
const eyebrow = [formatDate(date), `${minutes} min`, ...tags].join(' · ');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: 'Alireza Jafartash', url: 'https://jtash.ir/' },
  mainEntityOfPage: canonical.href,
};
---

<Base title={`${title} · jtash`} description={description} ogType="article" publishedTime={date} jsonLd={jsonLd}>
  <main class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="title">{title}</h1>
    <p class="lede">{description}</p>
    <article class="prose post-body">
      <slot />
    </article>
  </main>
</Base>
